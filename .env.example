# Database
# Connect to Neon, Supabase, AWS RDS, or local PostgreSQL with SSL pooling
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atelier?schema=public"

# Auth.js / NextAuth
# Generate via: openssl rand -hex 32
AUTH_SECRET="your-auth-secret-here-replace-with-openssl-rand-hex-32"
NEXTAUTH_SECRET="your-auth-secret-here-replace-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Subscription Billing
# The salon owner subscribes to use the software; clients book for free.
# Secret & Publishable keys from Stripe Dashboard (Developers > API keys)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret (from Stripe CLI: `stripe listen` or Dashboard Webhook settings)
STRIPE_WEBHOOK_SECRET=""
# Optional pre-created Price IDs from Stripe Product catalog (if omitted, inline price_data is used)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""

# Automated Notifications (Resend for Email & .ICS Calendar Invites)
# Optional in dev (falls back to console simulation if empty)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Atelier Bookings <bookings@atelier.dev>"

# SMS Notifications (Twilio)
# Optional in dev (falls back to console simulation if empty)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Cron Automation Secret (for /api/cron/reminders)
CRON_SECRET=""
